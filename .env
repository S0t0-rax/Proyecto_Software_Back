# ── Base de Datos (SQLite local para demo — sin necesitar PostgreSQL) ─────────
DATABASE_URL=sqlite:///./er_diagram_demo.db

# ── Supabase (no se usa en modo demo) ────────────────────────────────────────
SUPABASE_URL=https://placeholder.supabase.co
SUPABASE_SERVICE_KEY=placeholder-key

# ── Aplicación ────────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=demo-secret-key-local-2024
ALLOWED_ORIGINS=["http://localhost:4200","http://localhost:3000"]

# ── WebSockets / Bloqueo ──────────────────────────────────────────────────────
WS_HEARTBEAT_INTERVAL=30
LOCK_EXPIRATION_SECONDS=60
