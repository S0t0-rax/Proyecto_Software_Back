# ──────────────────────────────────────────────────────────────────────────────
# ARCHIVO DE EJEMPLO DE VARIABLES DE ENTORNO
# Copia este archivo a .env y rellena con tus valores reales.
# NUNCA subas el archivo .env real al repositorio.
# ──────────────────────────────────────────────────────────────────────────────

# ── Base de Datos Principal (PostgreSQL en Supabase) ──────────────────────────
# Formato: postgresql+psycopg2://user:password@host:port/database
DATABASE_URL=postgresql+psycopg2://postgres:<PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_SERVICE_KEY=<TU_SUPABASE_SERVICE_ROLE_KEY>

# ── Aplicación ────────────────────────────────────────────────────────────────
APP_ENV=development          # development | production
SECRET_KEY=cambia_esto_por_una_clave_segura_aleatoria
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000

# ── WebSockets ────────────────────────────────────────────────────────────────
WS_HEARTBEAT_INTERVAL=30     # segundos entre pings al cliente
LOCK_EXPIRATION_SECONDS=60   # tiempo máximo de bloqueo pesimista por recurso
